# Database
# Ersetze YOUR_POSTGRESQL_PASSWORD mit dem echten Passwort
DATABASE_URL="postgresql://y-b:YOUR_POSTGRESQL_PASSWORD@postgresql-y-b.alwaysdata.net/pon2_prod?schema=public"

# Redis (optional - falls verfügbar auf alwaysdata)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Server
PORT=3000
NODE_ENV="production"

# JWT - Generiere einen neuen sicheren Secret mit: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="GENERATE_A_SECURE_RANDOM_STRING_HERE"
JWT_EXPIRES_IN="7d"

# AI Services
# Füge deine API-Keys hinzu
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."

# External Integrations (optional)
GENEALOGY_NET_API_KEY=""
MYHERITAGE_API_KEY=""
PERPLEXITY_API_KEY=""

# Budget Limits (defaults)
DEFAULT_CASE_BUDGET_EUR=100
DEFAULT_MAX_API_CALLS_PER_SOURCE=50

# Logging
LOG_LEVEL="info"
