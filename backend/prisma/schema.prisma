// PoN2 Database Schema
// Inheritance Detective Application

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-1.0.x", "debian-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ============================================================================
// User Management
// ============================================================================

enum UserRole {
  DETECTIVE
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      UserRole @default(DETECTIVE)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  casesCreated Case[]    @relation("CreatedBy")
  casesAssigned Case[]   @relation("AssignedTo")
  comments     Comment[]

  @@map("users")
}

// ============================================================================
// Case Management
// ============================================================================

enum CaseStatus {
  NEW
  IN_RESEARCH
  WAITING_FOR_RESPONSE
  HEIRS_IDENTIFIED
  SUCCESSFULLY_SOLVED
  CLOSED_WITHOUT_SUCCESS
  ON_HOLD
}

model Case {
  id                String     @id @default(cuid())
  caseNumber        String     @unique // Aktenzeichen

  // Deceased person data
  deceasedFirstName String
  deceasedLastName  String
  deceasedBirthDate DateTime?
  deceasedDeathDate DateTime?
  birthPlace        String?
  deathPlace        String?

  // Case metadata
  status            CaseStatus @default(NEW)
  court             String?    // Zuständiges Gericht
  estateValue       Decimal?   @db.Decimal(12, 2)
  threshold         Decimal?   @db.Decimal(12, 2)

  // Source & References
  sourceType        String?    // z.B. "Bundesanzeiger"
  sourceReference   String?    // Link oder Referenz-ID
  originalText      String?    @db.Text

  // Budget & Limits
  budgetEur         Decimal    @default(100) @db.Decimal(10, 2)
  maxApiCallsPerSource Int     @default(50)
  currentSpentEur   Decimal    @default(0) @db.Decimal(10, 2)

  // Metrics
  successProbability Decimal?  @db.Decimal(5, 2) // 0-100%
  researchWaveCount Int       @default(0)

  // Notes & Results
  notes             String?    @db.Text
  resultSummary     String?    @db.Text

  // Timestamps
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  closedAt          DateTime?

  // Relations
  createdById       String
  createdBy         User       @relation("CreatedBy", fields: [createdById], references: [id])

  assignedToId      String?
  assignedTo        User?      @relation("AssignedTo", fields: [assignedToId], references: [id])

  persons           PersonCase[]
  artifacts         ResearchArtifact[]
  researchWaves     ResearchWave[]
  documents         Document[]
  budgetTracking    BudgetTracking[]
  strategyExecutions StrategyExecution[]
  comments          Comment[]

  @@index([status])
  @@index([createdAt])
  @@index([court])
  @@map("cases")
}

// ============================================================================
// Person & Relationship Management
// ============================================================================

enum PersonRole {
  DECEASED
  POTENTIAL_HEIR
  RELATIVE
  CONTACT_PERSON
  OTHER
}

model Person {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  birthDate   DateTime?
  deathDate   DateTime?
  birthPlace  String?
  deathPlace  String?
  gender      String?

  notes       String?   @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  cases           PersonCase[]
  contactInfos    ContactInfo[]
  relationshipsFrom Relationship[] @relation("PersonFrom")
  relationshipsTo   Relationship[] @relation("PersonTo")

  @@index([lastName, firstName])
  @@map("persons")
}

// Junction table for Person-Case with role
model PersonCase {
  id        String     @id @default(cuid())

  personId  String
  person    Person     @relation(fields: [personId], references: [id], onDelete: Cascade)

  caseId    String
  case      Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)

  role      PersonRole @default(RELATIVE)

  // Probability that this person is an heir (0-100%)
  heirProbability Decimal? @db.Decimal(5, 2)

  // Reasoning/Chain of thought for probability
  reasoning String?    @db.Text

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([personId, caseId])
  @@index([caseId, role])
  @@map("person_cases")
}

// ============================================================================
// Contact Information
// ============================================================================

enum ContactType {
  ADDRESS
  PHONE
  EMAIL
  SOCIAL_MEDIA
  WEBSITE
  OTHER
}

model ContactInfo {
  id          String      @id @default(cuid())

  type        ContactType
  value       String
  label       String?     // z.B. "Facebook", "LinkedIn", "Privat"

  isVerified  Boolean     @default(false)
  trustScore  Decimal?    @db.Decimal(5, 2) // 0-100%

  notes       String?     @db.Text

  personId    String
  person      Person      @relation(fields: [personId], references: [id], onDelete: Cascade)

  // Source artifacts that provided this contact info
  sourceArtifacts ResearchArtifact[] @relation("ContactInfoSources")

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([personId, type])
  @@map("contact_infos")
}

// ============================================================================
// Relationships
// ============================================================================

enum RelationshipType {
  PARENT
  CHILD
  SIBLING
  SPOUSE
  GRANDPARENT
  GRANDCHILD
  UNCLE_AUNT
  NEPHEW_NIECE
  COUSIN
  OTHER
}

model Relationship {
  id            String           @id @default(cuid())

  type          RelationshipType
  description   String?          // Optional description

  // From -> To relationship
  fromPersonId  String
  fromPerson    Person           @relation("PersonFrom", fields: [fromPersonId], references: [id], onDelete: Cascade)

  toPersonId    String
  toPerson      Person           @relation("PersonTo", fields: [toPersonId], references: [id], onDelete: Cascade)

  // Proof sources
  proofArtifacts ResearchArtifact[] @relation("RelationshipProofs")

  trustScore    Decimal?         @db.Decimal(5, 2) // 0-100%

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([fromPersonId, toPersonId, type])
  @@index([fromPersonId])
  @@index([toPersonId])
  @@map("relationships")
}

// ============================================================================
// Research Artifacts
// ============================================================================

enum ArtifactType {
  GENEALOGY_SEARCH
  SOCIAL_MEDIA_PROFILE
  PUBLIC_RECORD
  COURT_DOCUMENT
  PERPLEXITY_RESEARCH
  WEB_SEARCH
  MANUAL_NOTE
  OTHER
}

model ResearchArtifact {
  id            String        @id @default(cuid())

  type          ArtifactType
  source        String        // e.g., "genealogy.net", "MyHeritage", "Perplexity"
  sourceUrl     String?

  // Raw data
  rawText       String        @db.Text

  // Structured extracted data (JSON)
  structuredData Json?

  // Vectorized content for semantic search
  // Using pgvector extension
  embedding     String?       // Will store vector as string, processed by pgvector

  // Metadata
  relevanceScore Decimal?     @db.Decimal(5, 2)
  trustScore    Decimal?      @db.Decimal(5, 2)

  // Cost tracking
  apiCost       Decimal?      @db.Decimal(10, 4)

  caseId        String
  case          Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)

  researchWaveId String?
  researchWave  ResearchWave? @relation(fields: [researchWaveId], references: [id], onDelete: SetNull)

  strategyExecutionId String?
  strategyExecution StrategyExecution? @relation(fields: [strategyExecutionId], references: [id], onDelete: SetNull)

  // Relations for evidence
  contactInfos  ContactInfo[]    @relation("ContactInfoSources")
  relationships Relationship[]   @relation("RelationshipProofs")

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([caseId, type])
  @@index([source])
  @@index([createdAt])
  @@map("research_artifacts")
}

// ============================================================================
// Research Waves & Strategy Execution
// ============================================================================

enum WaveStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

model ResearchWave {
  id              String        @id @default(cuid())
  waveNumber      Int           // 1st wave, 2nd wave, etc.

  status          WaveStatus    @default(PENDING)

  // Configuration
  maxBudgetEur    Decimal       @db.Decimal(10, 2)
  actualCostEur   Decimal       @default(0) @db.Decimal(10, 2)

  // Results
  artifactsFound  Int           @default(0)
  personsFound    Int           @default(0)

  notes           String?       @db.Text

  caseId          String
  case            Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)

  artifacts       ResearchArtifact[]
  strategyExecutions StrategyExecution[]

  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([caseId, waveNumber])
  @@map("research_waves")
}

// ============================================================================
// Strategies
// ============================================================================

enum StrategyStatus {
  ACTIVE
  TESTED
  SUCCESSFUL
  FAILED
  DEPRECATED
}

model Strategy {
  id              String         @id @default(cuid())
  name            String
  description     String         @db.Text

  // The actual prompt/query template
  promptTemplate  String         @db.Text

  // Target integration
  targetIntegration String       // e.g., "genealogy.net", "perplexity"

  // Parameters (JSON)
  parameters      Json?

  status          StrategyStatus @default(ACTIVE)

  // Success metrics
  timesExecuted   Int            @default(0)
  timesSuccessful Int            @default(0)
  successRate     Decimal?       @db.Decimal(5, 2)
  avgArtifactsFound Decimal?     @db.Decimal(10, 2)
  avgCost         Decimal?       @db.Decimal(10, 4)

  // Learning: AI-generated or manually created
  isAiGenerated   Boolean        @default(false)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  executions      StrategyExecution[]

  @@index([status, successRate])
  @@map("strategies")
}

model StrategyExecution {
  id            String        @id @default(cuid())

  strategyId    String
  strategy      Strategy      @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  caseId        String
  case          Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)

  researchWaveId String?
  researchWave  ResearchWave? @relation(fields: [researchWaveId], references: [id], onDelete: SetNull)

  // Execution details
  status        WaveStatus    @default(PENDING)

  // Actual query sent (after template substitution)
  executedQuery String        @db.Text

  // Results
  artifactsCreated Int        @default(0)
  costEur       Decimal?      @db.Decimal(10, 4)

  wasSuccessful Boolean?      // Evaluated after completion

  errorMessage  String?       @db.Text

  artifacts     ResearchArtifact[]

  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([caseId])
  @@index([strategyId])
  @@map("strategy_executions")
}

// ============================================================================
// Documents & Communication
// ============================================================================

enum DocumentType {
  EMAIL
  LETTER
  INTERNAL_NOTE
  COURT_INQUIRY
  COURT_RESPONSE
  HEIR_CONTACT
  OTHER
}

model Document {
  id          String       @id @default(cuid())

  type        DocumentType
  direction   String       // "incoming" or "outgoing"

  subject     String?
  content     String       @db.Text

  // Addressee/Sender
  recipient   String?
  sender      String?

  // Attachments (file paths or URLs)
  attachments Json?

  // Vectorized for AI analysis
  embedding   String?

  caseId      String
  case        Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)

  sentAt      DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([caseId, type])
  @@map("documents")
}

// ============================================================================
// Integrations
// ============================================================================

model Integration {
  id          String   @id @default(cuid())

  name        String   @unique // e.g., "genealogy.net", "MyHeritage"
  type        String   // e.g., "genealogy", "social_media", "ai_research"

  isActive    Boolean  @default(true)

  // Configuration (API keys, endpoints, etc.)
  config      Json

  // Global limits
  dailyCallLimit Int?
  monthlyCostLimit Decimal? @db.Decimal(10, 2)

  // Tracking
  totalCalls  Int      @default(0)
  totalCost   Decimal  @default(0) @db.Decimal(12, 2)

  lastUsedAt  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("integrations")
}

// ============================================================================
// Budget Tracking
// ============================================================================

model BudgetTracking {
  id          String   @id @default(cuid())

  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  integration String   // Which integration was used

  action      String   // e.g., "genealogy_search", "perplexity_query"

  cost        Decimal  @db.Decimal(10, 4)

  metadata    Json?    // Additional tracking data

  createdAt   DateTime @default(now())

  @@index([caseId])
  @@index([createdAt])
  @@map("budget_tracking")
}

// ============================================================================
// Comments & Collaboration
// ============================================================================

model Comment {
  id        String   @id @default(cuid())

  content   String   @db.Text

  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@map("comments")
}
